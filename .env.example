# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://sunrise:sunrise@localhost:5432/sunrise
REDIS_URL=redis://localhost:6379

# --- LLM ---
# provider: openai (any OpenAI-compatible endpoint) | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: point at OpenRouter, NVIDIA NIM, or any OpenAI-compatible gateway.
LLM_BASE_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (optional; app works without it) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- App ---
DEMO_MODE=false
ADMIN_TOKEN=

# --- Bright Data (optional, separate auxiliary scraping service) ---
# npm i -g @brightdata/cli && bdata login   (or paste an API key here)
BRIGHTDATA_API_KEY=
