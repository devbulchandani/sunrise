# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://sunrise:sunrise@localhost:5432/sunrise
REDIS_URL=redis://localhost:6379

# --- LLM ---
# Gemini 3.1 Flash-Lite through Google's OpenAI-compatible endpoint.
LLM_PROVIDER=openai
# For Bedrock Mantle, use the OpenAI-compatible settings below and put the
# Bedrock bearer API key in LLM_API_KEY.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BEDROCK_REGION=us-east-1
# Bedrock Mantle example (uncomment to use GPT-OSS 20B instead of Gemini):
# LLM_MODEL=openai.gpt-oss-20b
# LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# For NVIDIA Nemotron-style reasoning models: keep the token budget for the answer
# instead of chain-of-thought (prepends /no_think to every system prompt).
LLM_NO_THINK=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (optional; app works without it) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- App ---
DEMO_MODE=false
ADMIN_TOKEN=
ARTICLE_RETENTION_DAYS=30

# --- Bright Data (optional, separate auxiliary scraping service) ---
# npm i -g @brightdata/cli && bdata login   (or paste an API key here)
BRIGHTDATA_API_KEY=
