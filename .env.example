# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://sunrise:sunrise@localhost:5432/sunrise
REDIS_URL=redis://localhost:6379

# --- LLM ---
# Gemini 3.1 Flash-Lite through Google's OpenAI-compatible endpoint.
LLM_PROVIDER=openai
# For Bedrock Mantle, use the OpenAI-compatible settings below and put the
# Bedrock bearer API key in LLM_API_KEY.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_BEDROCK_REGION=us-east-1
# Bedrock Mantle example (uncomment to use GPT-OSS 20B instead of Gemini):
# LLM_MODEL=openai.gpt-oss-20b
# LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# For NVIDIA Nemotron-style reasoning models: keep the token budget for the answer
# instead of chain-of-thought (prepends /no_think to every system prompt).
LLM_NO_THINK=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Anti-spam floors (urgency 0-100).
TELEGRAM_MIN_URGENCY=61
EMAIL_MIN_URGENCY=41

# --- Email (optional; app works without it) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- App ---
DEMO_MODE=false
# Ops-only token for CLI/curl. The dashboard does NOT receive this value.
# Leave empty in production and use ADMIN_EMAILS instead.
ADMIN_TOKEN=
# Comma-separated Cognito emails allowed to trigger runs/healing from the
# dashboard. Empty means the UI admin buttons return 403.
ADMIN_EMAILS=
# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=https://sunrise-dashboard.pages.dev,http://localhost:5173,http://127.0.0.1:5173
ARTICLE_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=30

# --- Clustering / analysis ---
CLUSTERING_CANDIDATE_LIMIT=500
CLUSTERING_SIMILARITY_THRESHOLD=66
CLUSTERING_JACCARD_FLOOR=0.3
ANALYSIS_MAX_ATTEMPTS=5
HEALING_STALE_MINUTES=30
SOURCE_LOCK_SECONDS=300

# --- Cognito (needed only for authenticated account/trading APIs) ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Trading stays off unless explicitly enabled after paper integration is reviewed.
TRADING_ENABLED=false

# --- Dashboard public Cognito configuration (set in frontend/.env.production) ---
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=

# --- Bright Data (optional, separate auxiliary scraping service) ---
# npm i -g @brightdata/cli && bdata login   (or paste an API key here)
BRIGHTDATA_API_KEY=
